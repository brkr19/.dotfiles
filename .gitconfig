# User configuration - configure in ~/.gitconfig.local
# See .gitconfig.local.example for template

[include]
    path = ~/.gitconfig.local

[credential]
    helper = cache --timeout=86400

[core]
    editor = vim

[diff]
    renames = copies

[commit]
    gpgsign = false

[help]
    autocorrect = prompt

[init]
    defaultBranch = main
